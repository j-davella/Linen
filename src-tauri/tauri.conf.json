{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Linen",
  "version": "0.2.0",
  "identifier": "dev.linen.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Linen",
        "width": 1600,
        "height": 1000,
        "minWidth": 1000,
        "minHeight": 640,
        "resizable": true,
        "decorations": true,
        "backgroundColor": "#04070d"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
